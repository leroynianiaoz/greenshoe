# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://greenshoe:greenshoe_dev_password@localhost:5433/greenshoe

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Credential Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-change-in-production

# Staging Domain Configuration
STAGING_DOMAIN=staging.yourdomain.com

# Operation Limits
MAX_SITE_SIZE_GB=2
OPERATION_TIMEOUT_MINUTES=30
MAX_SITES=10

# File Storage Paths
STAGING_BASE_PATH=./staging
ARCHIVE_BASE_PATH=./archives
BACKUP_BASE_PATH=./backups

# Logging
LOG_LEVEL=info
